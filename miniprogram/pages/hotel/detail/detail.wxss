/* pages/hotel/detail/detail.wxss */

/* 主容器 */
.hotel-detail-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 轮播图区域 */
.image-section {
  position: relative;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  gap: 20rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top: 4rpx solid #ff6b6b;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* 图片轮播区域 */
.image-section {
  position: relative;
  width: 100%;
  height: 500rpx;
  background: #fff;
}

.image-swiper {
  width: 100%;
  height: 100%;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.image-indicator {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background: rgba(0, 0, 0, 0.7);
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* 酒店信息卡片 */
.hotel-info-card {
  background: #fff;
  margin: -30rpx 20rpx 20rpx;
  border-radius: 20rpx 20rpx 0 0;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 标题区域 */
.header-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.title-wrapper {
  flex: 1;
}

.hotel-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.rating-wrapper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rating-star {
  font-size: 20rpx;
}

.rating-score {
  font-size: 24rpx;
  font-weight: 600;
  color: #ff6b6b;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 15rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
  border: 1rpx solid #e0e0e0;
}

.action-icon {
  font-size: 24rpx;
}

.action-text {
  font-size: 20rpx;
  color: #666;
}

.favorite-btn.favorited {
  background: #fff2f0;
  border-color: #ffccc7;
}

.favorite-btn.favorited .action-icon {
  color: #ff6b6b;
}

.favorite-btn.favorited .action-text {
  color: #ff6b6b;
  font-weight: 600;
}

/* 信息项 */
.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-icon {
  font-size: 24rpx;
  margin-right: 12rpx;
  width: 32rpx;
  text-align: center;
}

.info-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 12rpx;
  min-width: 140rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.address-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.address-text {
  line-height: 1.4;
}

.address-text:active {
  color: #ff6b6b;
}

.distance-info {
  font-size: 22rpx;
  color: #ff6b6b;
  font-weight: 600;
  background: #fff2f0;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  align-self: flex-start;
  margin-right: 10rpx;
}

/* 距离信息区域 */
.distance-section {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 10rpx;
  width: 100%;
}

.route-distance-info {
  font-size: 22rpx;
  color: #1890ff;
  font-weight: 600;
  background: #e6f7ff;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  align-self: flex-start;
  border-left: 4rpx solid #1890ff;
}

.calculating-info {
  font-size: 22rpx;
  color: #999;
  font-weight: 500;
  background: #f5f5f5;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  align-self: flex-start;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% { opacity: 0.6; }
  50% { opacity: 1; }
  100% { opacity: 0.6; }
}



/* 导航和拨号按钮 */
.navi-btn, .call-btn {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-left: 15rpx;
}

.navi-btn {
  background: #e6f7ff;
  border: 1rpx solid #91d5ff;
}

.call-btn {
  background: #f6ffed;
  border: 1rpx solid #b7eb8f;
}

.navi-text, .call-text {
  font-size: 22rpx;
  color: #1890ff;
}

.call-text {
  color: #52c41a;
}



/* 描述卡片 */
.desc-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.card-title::before {
  content: '';
  width: 6rpx;
  height: 24rpx;
  background: #ff6b6b;
  margin-right: 12rpx;
  border-radius: 3rpx;
}

.desc-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 美团风格服务项目区域 */
.services-section {
  margin: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.promotion-tag {
  background: #ff4d4f;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.meituan-services-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 美团风格服务卡片 */
.meituan-service-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  position: relative;
}

.meituan-service-card:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
}

/* 服务图片区域 */
.service-image-section {
  position: relative;
  height: 320rpx;
  overflow: hidden;
}

/* 服务图片轮播 */
.service-image-swiper {
  width: 100%;
  height: 100%;
}

.service-swiper-image {
  width: 100%;
  height: 100%;
}

/* 服务图片(单张) */
.service-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 服务内容区域 */
.service-content {
  padding: 24rpx;
}

.service-header-info {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.service-name-meituan {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  line-height: 1.3;
}

.service-desc-meituan {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 价格和抢购区域 */
.service-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.price-section-meituan {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.price-info {
  display: flex;
  align-items: baseline;
  color: #ff4d4f;
}

.price-symbol {
  font-size: 20rpx;
  font-weight: 500;
}

.price-number {
  font-size: 36rpx;
  font-weight: 700;
}

.price-unit {
  font-size: 22rpx;
  color: #ff4d4f;
  margin-left: 4rpx;
}

.buy-section {
  flex-shrink: 0;
}

.meituan-buy-btn {
  background: linear-gradient(135deg, #FF6B6B, #FF8E53);
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 107, 0.3);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.meituan-buy-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}

.meituan-buy-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transition: left 0.6s ease;
}

.meituan-buy-btn:active::before {
  left: 100%;
}

.buy-text {
  color: #fff;
  position: relative;
  z-index: 1;
}

/* 美团风格动画效果 */
.meituan-service-card {
  animation: slideInUp 0.5s ease-out;
}

@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.service-badge {
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
  100% {
    transform: scale(1);
  }
}

/* 悬浮效果 */
.meituan-service-card:hover .service-image {
  transform: scale(1.05);
  transition: transform 0.3s ease;
}

/* 房型列表 */
.rooms-section {
  margin: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.promotion-tag {
  background: #ff4d4f;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.rooms-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 房型卡片 */
.room-card {
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.room-card:active {
  transform: translateY(-2rpx) scale(0.98);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.15);
}

.room-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #FF6B6B, #FFB347);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.room-card:active::before {
  opacity: 1;
}

/* 房型头部 */
.room-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 30rpx 30rpx 20rpx;
}

.room-title-section {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.room-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.discount-badge {
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.discount-text {
  font-size: 20rpx;
}

.sales-info {
  text-align: right;
}

.sales-count {
  font-size: 22rpx;
  color: #999;
  background: #f0f0f0;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

/* 房型描述 */
.room-description {
  padding: 0 30rpx 20rpx;
}

.desc-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 价格区域 */
.price-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 20rpx 30rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.price-info {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.current-price {
  display: flex;
  align-items: baseline;
  color: #ff4d4f;
}

.price-symbol {
  font-size: 24rpx;
  font-weight: 500;
}

.price-number {
  font-size: 48rpx;
  font-weight: 700;
}

.price-unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

.savings-info {
  background: #fff2f0;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid #ffccc7;
}

.savings-text {
  font-size: 20rpx;
  color: #ff4d4f;
  font-weight: 500;
}

/* 操作按钮区域 */
.action-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
  justify-content: space-between;
}

.action-left {
  flex: 1;
}

.sold-out-btn, .buy-btn {
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  min-width: 120rpx;
  transition: all 0.3s ease;
}

.sold-out-btn {
  background: #f5f5f5;
  color: #ccc;
  border: 2rpx solid #e0e0e0;
}

.buy-btn {
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
  color: #fff;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 107, 0.3);
  flex: 1;
}

.buy-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 10rpx rgba(255, 107, 107, 0.3);
}

/* 房型规格 */
.room-specs {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 30rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.spec-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #fafafa;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #ff6b6b;
}

.spec-label {
  font-size: 22rpx;
  color: #666;
}

.spec-value {
  font-size: 22rpx;
  color: #333;
  font-weight: 500;
}

.stock-value {
  font-weight: bold;
  color: #52c41a;
}

.stock-empty {
  color: #ff4d4f;
}

/* 房型设施 */
.room-facilities {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.facilities-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 15rpx;
}

.facilities-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.facility-tag {
  font-size: 20rpx;
  color: #666;
  background: #f0f8ff;
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
  border: 1rpx solid #d6f1ff;
}

.more-facilities {
  font-size: 20rpx;
  color: #999;
  background: #f5f5f5;
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e0e0e0;
}

/* 房型图片轮播 - 参考酒店轮播图样式 */
.room-image-section {
  position: relative;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
}

.room-image-swiper {
  width: 100%;
  height: 400rpx;
}

.room-swiper-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 无图片占位符 */
.no-images-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 30rpx;
  margin: 20rpx 30rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 1rpx dashed #dee2e6;
}

.placeholder-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
  opacity: 0.6;
}

.placeholder-text {
  font-size: 24rpx;
  color: #6c757d;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 15rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.retry-btn {
  background: #ff6b6b;
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

/* 暂无房型提示 */
.no-rooms {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.no-rooms-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.no-rooms-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.no-rooms-desc {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  line-height: 1.5;
}

