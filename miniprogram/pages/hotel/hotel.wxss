/* pages/hotel/hotel.wxss */
.hotel-container {
  padding: 0 30rpx 40rpx;
  background: linear-gradient(180deg, #F8F9FA 0%, #FFFFFF 100%);
  min-height: 100vh;
}

/* 测试按钮区域 */
.test-section {
  display: flex;
  gap: 10rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.test-btn {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  background: #007bff;
  color: white;
  border-radius: 8rpx;
  border: none;
  margin: 0;
  min-width: 140rpx;
}

.test-btn:active {
  background: #0056b3;
}

/* 调试信息样式 */
.debug-section {
  background: #f8f9fa;
  border: 1rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.debug-header {
  font-size: 28rpx;
  font-weight: bold;
  color: #495057;
  margin-bottom: 10rpx;
}

.debug-block {
  background: white;
  border-radius: 8rpx;
  padding: 15rpx;
  margin-bottom: 10rpx;
}

.debug-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #007bff;
  display: block;
  margin-bottom: 8rpx;
}

.debug-block text {
  font-size: 24rpx;
  color: #6c757d;
  display: block;
  margin-bottom: 5rpx;
}

.hotel-mapping {
  font-size: 22rpx !important;
  color: #28a745 !important;
  background: #f8fff9;
  padding: 5rpx;
  border-radius: 4rpx;
  margin-bottom: 3rpx;
}

/* 调试房型信息样式 */
.debug-room-info {
  background: #fff3cd;
  border: 1rpx solid #ffeaa7;
  border-radius: 8rpx;
  padding: 15rpx;
  margin: 10rpx 0;
}

.debug-room-info .debug-title {
  font-weight: bold !important;
  color: #856404 !important;
  display: block;
  margin-bottom: 8rpx;
}

.debug-room-info text {
  font-size: 22rpx !important;
  color: #856404 !important;
  display: block;
  margin-bottom: 3rpx;
}

.debug-room-list {
  margin-top: 8rpx;
}

.room-count-title {
  font-weight: bold !important;
  color: #28a745 !important;
  display: block;
  margin-bottom: 5rpx;
}

.debug-room-item {
  background: #d4edda;
  padding: 5rpx;
  margin: 3rpx 0;
  border-radius: 4rpx;
}

.debug-room-item text {
  color: #155724 !important;
  font-size: 20rpx !important;
}

.debug-no-rooms {
  background: #f8d7da;
  padding: 8rpx;
  border-radius: 4rpx;
  margin-top: 5rpx;
}

.debug-no-rooms text {
  color: #721c24 !important;
  font-weight: bold !important;
}







/* 轮播图样式 */
.banner-section {
  margin: 0 -30rpx 40rpx;
}

.banner-swiper {
  height: 470rpx;  /* 增加高度 5cm (150rpx) */
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

/* 推荐酒店区域样式 */
.featured-section {
  margin-bottom: 50rpx;
}

.featured-hotels {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.featured-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #FF6B6B08 100%);
  border-radius: 28rpx;
  border: 2rpx solid rgba(255, 107, 107, 0.15);
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 107, 0.12);
  overflow: hidden;
  transition: all 0.3s ease;
  position: relative;
}

.featured-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 15rpx rgba(255, 107, 107, 0.2);
}

.featured-image {
  position: relative;
  height: 320rpx;
  overflow: hidden;
}

.featured-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.featured-rating {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: rgba(0, 0, 0, 0.7);
  color: #FFFFFF;
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  backdrop-filter: blur(10rpx);
}

.featured-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  color: #FFFFFF;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 15rpx rgba(255, 107, 107, 0.3);
}

.featured-info {
  padding: 30rpx;
}

.featured-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.featured-location {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 8rpx 12rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.featured-location:active {
  background: #E8EAED;
  transform: scale(0.98);
}

.featured-location .location-icon {
  font-size: 24rpx;
  color: #8E8E93;
}

.featured-location .location-text {
  font-size: 26rpx;
  color: #8E8E93;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.featured-location .location-arrow {
  font-size: 20rpx;
  color: #FF6B6B;
  font-weight: 600;
}

.featured-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.featured-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #F0F2F5;
  padding-top: 20rpx;
}

/* 区域标题样式 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 0 10rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.section-subtitle {
  font-size: 26rpx;
  color: #8E8E93;
}

/* 酒店列表样式 */
.hotels-section {
  padding-bottom: 40rpx;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  gap: 20rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #F0F2F5;
  border-top: 4rpx solid #FF6B6B;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #8E8E93;
}

.hotels-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hotel-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.hotel-card:active {
  transform: translateY(-8rpx);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
}

.hotel-image {
  position: relative;
  height: 280rpx;
  overflow: hidden;
}

.hotel-img {
  width: 100%;
  height: 100%;
  transition: transform 0.3s ease;
}

.hotel-card:active .hotel-img {
  transform: scale(1.05);
}

.hotel-rating {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(10rpx);
  color: #FFFFFF;
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rating-star {
  font-size: 20rpx;
}

.hotel-status {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: rgba(255, 59, 48, 0.9);
  backdrop-filter: blur(10rpx);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.status-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.hotel-info {
  padding: 30rpx;
}

.hotel-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 16rpx;
  line-height: 1.3;
}

.hotel-location {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.location-icon {
  font-size: 24rpx;
  color: #8E8E93;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.location-text {
  font-size: 26rpx;
  color: #8E8E93;
  line-height: 1.4;
  flex: 1;
}

.hotel-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.tag {
  background: #FFF2F0;
  color: #FF6B6B;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  border: 1rpx solid #FFCCC7;
}

.hotel-meta {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.meta-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.distance {
  font-size: 24rpx;
  color: #8E8E93;
}

.business-hours {
  font-size: 22rpx;
  color: #8E8E93;
  background: #F8F9FA;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  display: inline-block;
}

.price-info {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.price-unit {
  font-size: 24rpx;
  color: #8E8E93;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8E8E93;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.empty-actions {
  display: flex;
  gap: 20rpx;
}

.retry-btn, .reset-btn {
  padding: 16rpx 32rpx;
  border-radius: 25rpx;
  font-size: 26rpx;
  border: none;
}

.retry-btn {
  background: #FF6B6B;
  color: #FFFFFF;
}

.reset-btn {
  background: #F8F9FA;
  color: #8E8E93;
  border: 1rpx solid #F0F2F5;
}

/* 遮罩层 */
.filter-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.filter-mask.show {
  opacity: 1;
  pointer-events: auto;
}

/* 房型展示样式 */
.rooms-preview {
  margin: 20rpx 0;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 107, 107, 0.1);
}

.rooms-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 16rpx;
}

.rooms-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.room-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx;
  border: 1rpx solid #F0F2F5;
}

.room-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.room-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1C1C1E;
}

.room-price {
  font-size: 24rpx;
  color: #FF6B6B;
  font-weight: 600;
}

.room-capacity {
  font-size: 22rpx;
  color: #8E8E93;
  background: #F8F9FA;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.more-rooms {
  text-align: center;
  font-size: 24rpx;
  color: #8E8E93;
  padding: 12rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  margin-top: 8rpx;
}

/* 调试信息样式 */
.debug-info {
  background: #fff3cd;
  border: 1rpx solid #ffeaa7;
  border-radius: 8rpx;
  padding: 12rpx;
  margin: 10rpx 0;
  font-size: 20rpx;
  color: #856404;
}

.debug-info text {
  display: block;
  margin-bottom: 4rpx;
}

/* 完整房型卡片样式 */
.room-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #F0F2F5;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.room-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.room-title-section {
  flex: 1;
}

.room-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 8rpx;
}

.discount-badge {
  display: inline-block;
  background: #FF6B6B;
  color: #FFFFFF;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  margin-left: 12rpx;
}

.discount-text {
  font-weight: 500;
}

.sales-info {
  text-align: right;
}

.sales-count {
  font-size: 22rpx;
  color: #FF6B6B;
  background: #FFF2F0;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.room-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.room-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.more-images {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #8E8E93;
}

.room-description {
  margin-bottom: 16rpx;
}

.desc-content {
  font-size: 26rpx;
  color: #8E8E93;
  line-height: 1.4;
}

.room-specs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.spec-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #8E8E93;
}

.spec-label {
  font-weight: 500;
}

.spec-value {
  color: #1C1C1E;
}

.stock-info {
  display: flex;
  align-items: center;
}

.stock-text {
  font-size: 22rpx;
  color: #FF6B6B;
  background: #FFF2F0;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.room-facilities {
  margin-bottom: 20rpx;
}

.facilities-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 12rpx;
}

.facilities-list {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.facility-tag {
  font-size: 22rpx;
  color: #8E8E93;
  background: #F8F9FA;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid #F0F2F5;
}

.more-facilities {
  font-size: 22rpx;
  color: #8E8E93;
}

.price-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.price-section .price-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.current-price {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price-symbol {
  font-size: 24rpx;
  color: #FF6B6B;
  font-weight: 600;
}

.price-number {
  font-size: 32rpx;
  color: #FF6B6B;
  font-weight: 700;
}

.price-unit {
  font-size: 20rpx;
  color: #8E8E93;
}

.original-price {
  font-size: 24rpx;
  color: #8E8E93;
  text-decoration: line-through;
}

.savings-info {
  align-self: flex-start;
}

.savings-text {
  font-size: 20rpx;
  color: #52C41A;
  background: #F6FFED;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
}

.buy-section {
  display: flex;
  align-items: center;
}

.buy-btn {
  background: #FF6B6B;
  color: #FFFFFF;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.buy-text {
  color: inherit;
}

.sold-out-btn {
  background: #F8F9FA;
  color: #8E8E93;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  border: 1rpx solid #F0F2F5;
}

.sold-out-text {
  color: inherit;
}

/* 调试样式 */
.simple-rooms-debug {
  background: #f0f8ff;
  border: 2rpx solid #007bff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin: 16rpx 0;
  font-size: 22rpx;
  color: #333;
}

.debug-title {
  font-weight: bold;
  color: #007bff;
  margin-bottom: 12rpx;
  display: block;
}

.simple-rooms-debug text {
  display: block;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.room-list-simple {
  margin-top: 12rpx;
  background: #fff;
  padding: 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid #007bff;
}

.simple-room-title {
  font-weight: bold;
  margin-bottom: 8rpx;
  display: block;
}

.simple-room-item {
  background: #e7f5ff;
  padding: 8rpx 12rpx;
  margin-bottom: 6rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
}

.no-rooms-debug {
  background: #fff2f0;
  color: #ff4d4f;
  padding: 12rpx;
  border-radius: 8rpx;
  text-align: center;
  margin-top: 12rpx;
}