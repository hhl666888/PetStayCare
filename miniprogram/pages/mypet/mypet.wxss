/* pages/mypet/mypet.wxss - 我的宠物页面样式 */

.pets-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #ff9a76 0%, #ff7a45 100%);
  position: relative;
}

/* 头部样式 */
.header {
  padding: 40rpx 30rpx 20rpx;
  text-align: center;
  display: flex;
  align-items: center;
  position: relative;
}

.header-left {
  position: absolute;
  left: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  transition: all 0.3s ease;
}

.header-left:active {
  transform: translateY(-50%) scale(0.9);
  background: rgba(255, 255, 255, 0.3);
}

.back-icon {
  font-size: 32rpx;
  color: white;
  font-weight: bold;
}

.header-content {
  position: relative;
  z-index: 1;
  flex: 1;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  display: block;
  margin-bottom: 10rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
}

/* 主要内容区域 */
.main-content {
  padding: 0 30rpx 30rpx;
}

/* 未登录提示 */
.login-prompt {
  text-align: center;
  padding: 100rpx 40rpx;
  color: white;
}

.prompt-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.8;
}

.prompt-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: block;
}

.prompt-desc {
  font-size: 28rpx;
  opacity: 0.8;
  margin-bottom: 40rpx;
  display: block;
}

.login-btn {
  background: white;
  color: #ff7a45;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s ease;
}

.login-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* 添加宠物区域 */
.add-pet-section {
  margin-bottom: 30rpx;
}

.add-pet-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  backdrop-filter: blur(10rpx);
  border: 2rpx dashed rgba(255, 154, 118, 0.3);
  transition: all 0.3s ease;
}

.add-pet-card:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.95);
}

.add-icon {
  font-size: 60rpx;
  color: #ff9a76;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.add-text {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.add-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
}

/* 宠物列表 */
.pets-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pet-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.pet-card:active {
  transform: scale(0.98);
}

.pet-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.pet-image {
  width: 100%;
  height: 100%;
}

.pet-info {
  flex: 1;
  min-width: 0;
}

.pet-name-section {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.pet-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 12rpx;
}

.pet-gender {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: #ff9a76;
}

.gender-icon {
  font-size: 20rpx;
  color: white;
  font-weight: bold;
}

.pet-details {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.pet-breed, .pet-age, .pet-weight {
  font-size: 26rpx;
  color: #666;
}

.pet-weight {
  color: #ff9a76;
  font-weight: 500;
}

.pet-notes {
  margin-top: 8rpx;
  padding: 8rpx 16rpx;
  background: rgba(255, 154, 118, 0.1);
  border-radius: 8rpx;
  display: inline-block;
}

.notes-text {
  font-size: 22rpx;
  color: #888;
  line-height: 1.4;
}



.pet-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}

.action-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.edit-btn {
  background: rgba(52, 211, 153, 0.1);
  border: 1rpx solid rgba(52, 211, 153, 0.3);
}

.delete-btn {
  background: rgba(255, 71, 87, 0.1);
  border: 1rpx solid rgba(255, 71, 87, 0.3);
}

.action-btn:active {
  transform: scale(0.9);
}

.btn-icon {
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: white;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.8;
}

.empty-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: block;
}

.empty-desc {
  font-size: 28rpx;
  opacity: 0.8;
  display: block;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
}

.modal-content {
  background: white;
  border-radius: 20rpx;
  width: 100%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  font-size: 40rpx;
  color: #999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  background: #f5f5f5;
}

.modal-body {
  padding: 30rpx;
  overflow-y: auto;
  flex: 1;
}

.modal-footer {
  padding: 30rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  gap: 20rpx;
  flex-shrink: 0;
}

/* 表单样式 */
.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #f9f9f9;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #ff9a76;
  background: white;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #f9f9f9;
  box-sizing: border-box;
}

.form-textarea:focus {
  border-color: #ff9a76;
  background: white;
}

/* 头像上传 */
.avatar-upload {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  overflow: hidden;
  margin: 0 auto;
  border: 3rpx solid rgba(255, 154, 118, 0.3);
  transition: all 0.3s ease;
}

.avatar-upload:active {
  transform: scale(0.95);
  border-color: #ff9a76;
}

.avatar-upload.uploading {
  border-color: #ff9a76;
  opacity: 0.8;
}

.avatar-preview {
  width: 100%;
  height: 100%;
  border-radius: 80rpx;
}

.upload-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 80rpx;
}

.upload-text {
  color: white;
  font-size: 24rpx;
}

/* 上传中状态 */
.uploading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 80rpx;
}

.uploading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top: 3rpx solid #ff9a76;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 12rpx;
}

.uploading-text {
  color: white;
  font-size: 20rpx;
  text-align: center;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 选择器样式 */
.picker-view {
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #f9f9f9;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

/* 性别选择 */
.gender-options {
  display: flex;
  gap: 20rpx;
}

.gender-option {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9f9f9;
  transition: all 0.3s ease;
}

.gender-option.active {
  border-color: #ff9a76;
  background: rgba(255, 154, 118, 0.1);
}

.gender-text {
  font-size: 28rpx;
  color: #333;
}



/* 按钮样式 */
.btn {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background: linear-gradient(135deg, #ff9a76 0%, #ff7a45 100%);
  color: white;
}

.btn:active {
  transform: scale(0.98);
}

.btn:disabled {
  opacity: 0.5;
  transform: none;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .pets-container {
    padding: 0;
  }
  
  .main-content {
    padding: 0 20rpx 20rpx;
  }
  
  .modal-mask {
    padding: 20rpx;
  }
  
  .pet-card {
    padding: 24rpx;
  }
  
  .pet-avatar {
    width: 100rpx;
    height: 100rpx;
    border-radius: 50rpx;
  }
}