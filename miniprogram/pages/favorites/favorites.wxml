<!--pages/favorites/favorites.wxml - 我的收藏页面-->
<view class="favorites-container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载收藏列表...</text>
  </view>

  <!-- 收藏列表内容 -->
  <view wx:elif="{{!emptyState && favorites.length > 0}}" class="content-wrapper">
    <!-- 排序工具栏 -->
    <view class="sort-toolbar">
      <view class="sort-left">
        <text class="sort-label">排序：</text>
        <view class="sort-btn" bindtap="changeSortType">
          <text class="sort-text">
            <block wx:if="{{sortType === 'time'}}">时间</block>
            <block wx:elif="{{sortType === 'name'}}">名称</block>
            <block wx:elif="{{sortType === 'rating'}}">评分</block>
          </text>
          <text class="sort-arrow">{{sortDirection === 'desc' ? '↓' : '↑'}}</text>
        </view>
      </view>
      <view class="sort-right">
        <view class="sort-btn" bindtap="changeSortDirection">
          <text class="sort-text">{{sortDirection === 'desc' ? '降序' : '升序'}}</text>
        </view>
        <view class="sort-btn danger" bindtap="onClearAll">
          <text class="sort-text">清空</text>
        </view>
      </view>
    </view>

    <!-- 收藏酒店列表 -->
    <view class="favorites-list">
      <block wx:for="{{favorites}}" wx:key="id">
        <view class="favorite-card">
          <!-- 酒店图片区域 -->
          <view class="card-image" bindtap="onHotelTap" data-id="{{item.id}}">
            <image 
              src="{{item.image}}" 
              mode="aspectFill" 
              class="hotel-image"
            />
            <view class="image-overlay">
              <view class="rating-badge">
                <text class="rating-star">⭐</text>
                <text class="rating-text">{{item.rating}}</text>
              </view>
            </view>
          </view>

          <!-- 酒店信息区域 -->
          <view class="card-content">
            <!-- 酒店名称和操作 -->
            <view class="card-header">
              <view class="hotel-info" bindtap="onHotelTap" data-id="{{item.id}}">
                <text class="hotel-name">{{item.name}}</text>
                <view class="hotel-tags">
                  <block wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">
                    <text class="tag">{{tag}}</text>
                  </block>
                </view>
              </view>
              <view class="action-area">
                <view class="remove-btn" bindtap="onRemoveFavorite" data-id="{{item.id}}" data-name="{{item.name}}">
                  <text class="remove-icon">❌</text>
                </view>
              </view>
            </view>

            <!-- 地址信息 -->
            <view class="address-section">
              <view class="address-wrapper">
                <text class="address-icon">📍</text>
                <text class="address-text">{{item.address}}</text>
              </view>
            </view>

            <!-- 其他信息 -->
            <view class="card-meta">
              <view class="meta-item" wx:if="{{item.businessHours}}">
                <text class="meta-icon">🕒</text>
                <text class="meta-text">{{item.businessHours}}</text>
              </view>
              <view class="meta-item" wx:if="{{item.phone}}">
                <text class="meta-icon">📞</text>
                <text class="meta-text">{{item.phone}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty-state">
    <view class="empty-content">
      <text class="empty-icon">💝</text>
      <text class="empty-title">暂无收藏</text>
      <text class="empty-desc">快去发现喜欢的酒店并收藏吧！</text>
      <button class="explore-btn" bindtap="goToExplore">
        <text class="btn-text">去发现酒店</text>
      </button>
    </view>
  </view>
</view>