/* index.wxss - 用户登录页面样式 */
.auth-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8F9FA 0%, #FFFFFF 100%);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.decoration-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 107, 107, 0.08);
  animation: float 6s ease-in-out infinite;
}

.circle-1 {
  width: 200rpx;
  height: 200rpx;
  top: -100rpx;
  right: -100rpx;
  animation-delay: 0s;
}

.circle-2 {
  width: 150rpx;
  height: 150rpx;
  bottom: -75rpx;
  left: -75rpx;
  animation-delay: 2s;
}

.circle-3 {
  width: 100rpx;
  height: 100rpx;
  top: 50%;
  right: 10%;
  animation-delay: 4s;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-40rpx); }
}

.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 60rpx 40rpx;
  position: relative;
  z-index: 1;
}

.header {
  text-align: center;
  margin-bottom: 80rpx;
}

.app-title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 16rpx;
}

.app-subtitle {
  display: block;
  font-size: 28rpx;
  color: #8E8E93;
  font-weight: 400;
}

.auth-section {
  background: white;
  border-radius: 32rpx;
  padding: 50rpx 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #F0F2F5;
}

.input-section {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.input-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 8rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 8rpx;
}

.required {
  color: #FF6B6B;
  margin-right: 4rpx;
}

.account-input, .password-input {
  height: 96rpx;
  padding: 0 24rpx;
  border: 2rpx solid #E8EAED;
  border-radius: 16rpx;
  font-size: 32rpx;
  background-color: #F8F9FA;
  transition: all 0.3s ease;
  color: #1C1C1E;
}

.account-input:focus, .password-input:focus {
  border-color: #FF6B6B;
  background-color: white;
  box-shadow: 0 0 0 4rpx rgba(255, 107, 107, 0.1);
  outline: none;
}

.register-link {
  text-align: center;
  margin-top: 30rpx;
}

.register-text {
  color: #8E8E93;
  font-size: 28rpx;
}

.register-btn {
  color: #FF6B6B;
  font-size: 28rpx;
  font-weight: 600;
  margin-left: 8rpx;
}

.user-profile {
  text-align: center;
  padding: 40rpx;
}

.profile-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1C1C1E;
}

.profile-status {
  font-size: 24rpx;
  color: #28a745;
  background-color: #d4edda;
  padding: 8rpx 24rpx;
  border-radius: 40rpx;
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.action-btn {
  border-radius: 32rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx 60rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
}

.action-btn.primary {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  color: white;
}

.action-btn.primary:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.4);
}

.btn-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.btn-icon {
  font-size: 36rpx;
}

.quick-enter-btn {
  background: white;
  color: #FF6B6B;
  border: 2rpx solid rgba(255, 107, 107, 0.2);
  font-size: 28rpx;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 20rpx;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.quick-enter-btn:active {
  background: #FF6B6B;
  color: white;
  transform: scale(0.98);
}

.quick-icon {
  font-size: 28rpx;
}

.loading-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  color: #FF6B6B;
  font-size: 28rpx;
  border: 1rpx solid rgba(255, 107, 107, 0.2);
}

.loading-icon {
  font-size: 28rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
