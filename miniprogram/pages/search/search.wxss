/* pages/search/search.wxss - 搜索页面样式 */
.search-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8F9FA 0%, #FFFFFF 100%);
}

/* 搜索头部 */
.search-header {
  background-color: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #f8f8f8;
  border-radius: 50rpx;
  padding: 0 30rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  padding: 0 20rpx;
  background-color: transparent;
  border: none;
}

.search-btn {
  background: linear-gradient(45deg, #ff6b6b, #ff8787);
  color: white;
  border: none;
  border-radius: 40rpx;
  padding: 15rpx 30rpx;
  font-size: 26rpx;
  margin-left: 20rpx;
}

.search-btn::after {
  border: none;
}

/* 筛选条件 */
.filter-section {
  background-color: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 20rpx;
  background-color: #f8f8f8;
  border-radius: 25rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s ease;
}

.filter-item.active {
  background-color: #ff6b6b;
  color: white;
}

/* 搜索历史 */
.search-history {
  padding: 30rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.history-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.clear-history {
  font-size: 24rpx;
  color: #999;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-item {
  padding: 12rpx 24rpx;
  background-color: #f0f0f0;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

/* 搜索结果 */
.search-results {
  padding: 0 30rpx;
}

.result-count {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

/* 搜索结果列表 - 与首页保持一致 */
.featured-hotels {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.featured-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #FF6B6B08 100%);
  border-radius: 28rpx;
  border: 2rpx solid rgba(255, 107, 107, 0.15);
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 107, 0.12);
  overflow: hidden;
  transition: all 0.3s ease;
  position: relative;
}

.featured-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 15rpx rgba(255, 107, 107, 0.2);
}

.featured-image {
  position: relative;
  height: 320rpx;
  overflow: hidden;
}

.featured-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.featured-rating {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: rgba(0, 0, 0, 0.7);
  color: #FFFFFF;
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  backdrop-filter: blur(10rpx);
}

.featured-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  color: #FFFFFF;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 15rpx rgba(255, 107, 107, 0.3);
}

.featured-info {
  padding: 30rpx;
}

.featured-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.featured-location {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 8rpx 12rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.featured-location:active {
  background: #E8EAED;
  transform: scale(0.98);
}

.featured-location .location-icon {
  font-size: 24rpx;
  color: #8E8E93;
}

.featured-location .location-text {
  font-size: 26rpx;
  color: #8E8E93;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.featured-location .location-arrow {
  font-size: 20rpx;
  color: #FF6B6B;
  font-weight: 600;
}

.featured-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}





/* 标签样式 */
.tag {
  background: #FFF2F0;
  color: #FF6B6B;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  border: 1rpx solid #FFCCC7;
}

.distance {
  font-size: 24rpx;
  color: #8E8E93;
}



/* 无结果 */
.no-results {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.no-result-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}

.no-result-text {
  font-size: 32rpx;
  color: #666;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.no-result-tip {
  font-size: 26rpx;
  color: #999;
}

/* 热门搜索 */
.hot-search {
  padding: 60rpx 30rpx;
}

.hot-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 30rpx;
}

.hot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hot-item {
  padding: 12rpx 24rpx;
  background-color: #f0f0f0;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.2s ease;
}

.hot-item:active {
  background-color: #e8e8e8;
  transform: scale(0.95);
}