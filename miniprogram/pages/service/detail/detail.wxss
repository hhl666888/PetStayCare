/* pages/service/detail/detail.wxss - 服务详情页面样式 */
.service-detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120px;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  background-color: #f5f5f5;
}

.loading-text {
  font-size: 16px;
  color: #999;
}

/* 内容包裹器 */
.content-wrapper {
  width: 100%;
}

/* 图片轮播区域 */
.swiper-section {
  position: relative;
  width: 100%;
  height: 400rpx;
}

.service-swiper {
  width: 100%;
  height: 100%;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.image-indicator {
  position: absolute;
  bottom: 20rpx;
  right: 30rpx;
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background-color: rgba(255, 152, 0, 0.85);
  border-radius: 30rpx;
}

.current {
  font-size: 24rpx;
  color: white;
  font-weight: bold;
}

.separator {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin: 0 8rpx;
}

.total {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 信息区域 */
.info-section {
  background-color: white;
  padding: 30rpx;
  margin-top: -20rpx;
  border-radius: 30rpx 30rpx 0 0;
  position: relative;
  z-index: 10;
}

/* 服务头部 */
.service-header {
  margin-bottom: 30rpx;
}

.name-section {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.service-name {
  flex: 1;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
}

.tag-row {
  margin-bottom: 30rpx;
}

.type-tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.type-tag-orange {
  background: linear-gradient(135deg, #ff9800 0%, #f57c00 100%);
  color: white;
}

.type-tag-blue {
  background: linear-gradient(135deg, #2196f3 0%, #1976d2 100%);
  color: white;
}

.type-tag-green {
  background: linear-gradient(135deg, #4caf50 0%, #388e3c 100%);
  color: white;
}

.price-section {
  display: flex;
  align-items: baseline;
  color: #ff5722;
}

.price-symbol {
  font-size: 28rpx;
  font-weight: bold;
}

.price-value {
  font-size: 52rpx;
  font-weight: bold;
  margin-left: 4rpx;
  color: #ff5722;
}

.price-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
  font-weight: 500;
}

/* 通用区块标题 */
.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.title-icon {
  margin-right: 10rpx;
  font-size: 32rpx;
}

/* 描述框 */
.description-box {
  background-color: #f8f9fa;
  padding: 25rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  border-left: 6rpx solid #ff9800;
}

.description-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.description-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

/* 包含项目 */
.included-box {
  background-color: #f0fdf4;
  padding: 25rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid #bbf7d0;
}

.included-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.included-item {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  background-color: white;
  border-radius: 10rpx;
}

.included-check {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4caf50 0%, #388e3c 100%);
  color: white;
  font-size: 22rpx;
  font-weight: bold;
  border-radius: 50%;
  margin-right: 16rpx;
}

.included-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

/* 预订规则 */
.rules-box {
  background-color: #fffbeb;
  padding: 25rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid #fde68a;
}

.rules-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  background-color: white;
  border-radius: 10rpx;
}

.rule-num {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: white;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rule-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

/* 安全须知 */
.safety-box {
  background-color: #fef2f2;
  padding: 25rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid #fecaca;
}

.safety-title {
  color: #dc2626;
}

.safety-content {
  background-color: white;
  padding: 20rpx;
  border-radius: 10rpx;
}

.safety-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

/* 人员要求 */
.staff-box {
  background-color: #eff6ff;
  padding: 25rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid #bfdbfe;
}

.staff-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.staff-tag {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: white;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 30rpx;
}

/* 详情网格 */
.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.detail-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.detail-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.detail-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 特色、包含、须知等盒子 */
.features-box,
.includes-box,
.notice-box,
.pets-box,
.time-box,
.hotel-info-box,
.detail-box {
  margin-bottom: 30rpx;
}

.features-title,
.includes-title,
.notice-title,
.pets-title,
.time-title,
.hotel-title,
.detail-box-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 特色列表 */
.features-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.feature-item {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #ff9800 0%, #f57c00 100%);
  border-radius: 30rpx;
}

.feature-text {
  font-size: 24rpx;
  color: white;
  font-weight: 500;
}

/* 包含列表 */
.includes-list,
.notice-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.include-item,
.notice-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.include-icon {
  font-size: 28rpx;
  color: #4ecdc4;
  font-weight: bold;
  margin-right: 12rpx;
  margin-top: 2rpx;
}

.include-text,
.notice-text,
.detail-box-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.detail-box-text {
  display: block;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

/* 宠物标签 */
.pets-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pet-tag {
  padding: 10rpx 20rpx;
  background-color: #fff3e0;
  border-radius: 20rpx;
  border: 1rpx solid #ff9800;
}

.pet-text {
  font-size: 24rpx;
  color: #ff9800;
}

/* 时间 */
.time-text {
  display: block;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 酒店卡片 */
.hotel-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 16rpx;
}

.hotel-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.hotel-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hotel-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.hotel-address {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
}

.hotel-phone {
  font-size: 24rpx;
  color: #ff6b6b;
  margin-top: 4rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 15rpx 30rpx;
  padding-bottom: calc(15rpx + env(safe-area-inset-bottom));
  background-color: white;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.book-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff9800 0%, #f57c00 100%);
  border-radius: 44rpx;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  padding: 0;
  line-height: 88rpx;
  border: none;
}

.book-text {
  margin-right: 15rpx;
}

.book-price {
  font-size: 36rpx;
}