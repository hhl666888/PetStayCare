/* pages/register/register.wxss - 用户注册页面样式（重新编写） */

page {
  min-height: 100vh;
  background: linear-gradient(135deg, #ff9a76 0%, #ff7a45 100%);
}

.register-container {
  min-height: 100vh;
  padding: 0 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 头部样式 */
.register-header {
  text-align: center;
  padding: 40rpx 0 30rpx 0;
  flex-shrink: 0;
}

.register-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.pet-icon {
  font-size: 64rpx;
}

.title-text {
  font-size: 56rpx;
  font-weight: bold;
  color: white;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.register-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
}

/* 表单容器 */
.register-form {
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
  flex: 1;
  min-height: 0;
}

/* 表单组 */
.form-group {
  margin-bottom: 40rpx;
  width: 100%;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

/* 表单标签 */
.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.required {
  color: #ff7a45;
  margin-right: 4rpx;
}

/* 表单输入 */
.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: white;
  box-sizing: border-box;
  transition: border-color 0.3s ease;
}

.form-input:focus {
  border-color: #ff9a76;
  outline: none;
}

.form-input:disabled {
  background: #f8f8f8;
  color: #999;
  border-color: #eee;
}

/* 行布局 */
.form-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.form-row .form-group {
  flex: 1;
  margin-bottom: 0;
}

/* 头像上传 */
.avatar-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 16rpx 0;
}

.avatar-upload {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #ff9a76;
  background: #fafafa;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  transition: all 0.3s ease;
  overflow: hidden;
}

.avatar-upload.uploading {
  border-color: #ffb380;
  background: rgba(255, 154, 118, 0.05);
}

.avatar-upload:active {
  transform: scale(0.95);
  border-color: #ff7a45;
}

.avatar-preview {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.avatar-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.avatar-upload.uploading .avatar-icon {
  animation: uploadingIcon 1.5s ease-in-out infinite;
}

.avatar-hint {
  font-size: 20rpx;
  color: #666;
  text-align: center;
}

/* 上传中覆盖层 */
.uploading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.uploading-text {
  color: white;
  font-size: 20rpx;
  font-weight: bold;
}

/* 上传动画 */
@keyframes uploadingIcon {
  0%, 100% { 
    transform: scale(1); 
    opacity: 1;
  }
  50% { 
    transform: scale(1.1); 
    opacity: 0.8;
  }
}

/* 性别选择 */
.gender-options {
  display: flex;
  gap: 24rpx;
  padding: 8rpx 0;
}

.gender-option {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 24rpx;
  background: white;
  transition: all 0.3s ease;
  min-width: 120rpx;
}

.gender-option.active {
  border-color: #ff9a76;
  background: #fff7f5;
}

.gender-text {
  font-size: 28rpx;
  color: #333;
}

.gender-option.active .gender-text {
  color: #ff7a45;
  font-weight: 500;
}

/* 选择器 */
.picker-view {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: white;
  display: flex;
  align-items: center;
  color: #333;
  box-sizing: border-box;
}

.picker-view.disabled {
  background: #f8f8f8;
  color: #999;
  border-color: #eee;
}

/* 按钮组 */
.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  border: none;
  outline: none;
}

.btn-primary {
  background: linear-gradient(135deg, #ff9a76 0%, #ff7a45 100%);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(255,122,69,0.3);
}

.btn-primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(255,122,69,0.3);
}

.btn-secondary {
  background: white;
  color: #666;
  border: 2rpx solid #e5e5e5;
}

.btn-secondary:active {
  background: #f8f8f8;
}

.btn:disabled {
  opacity: 0.6;
  transform: none !important;
}

/* 加载动画 */
.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(255,255,255,0.3);
  border-top: 4rpx solid white;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.btn.loading .btn-text {
  display: none;
}

/* 响应式设计 */
@media screen and (max-width: 750rpx) {
  .register-container {
    padding: 20rpx;
  }
  
  .form-row {
    flex-direction: column;
    gap: 0;
  }
  
  .form-row .form-group {
    margin-bottom: 32rpx;
  }
  
  .gender-options {
    gap: 16rpx;
  }
  
  .gender-option {
    padding: 12rpx 24rpx;
    min-width: 100rpx;
  }
  
  .form-actions {
    flex-direction: column;
    gap: 16rpx;
  }
  
  .btn {
    height: 80rpx;
    font-size: 30rpx;
  }
}