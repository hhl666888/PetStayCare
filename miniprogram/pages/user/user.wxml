<!--pages/user/user.wxml - 用户中心页面-->
<view class="user-container">
  <!-- 背景装饰 -->
  <view class="bg-decoration">
    <view class="decoration-circle circle-1"></view>
    <view class="decoration-circle circle-2"></view>
  </view>
  
  <!-- 主要内容 -->
  <view class="main-content">
    <!-- 用户信息卡片 -->
    <view class="user-card">
      <view class="user-avatar-section">
        <image class="user-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        <view class="avatar-badge" wx:if="{{hasUserInfo}}">
          <text class="badge-text">已认证</text>
        </view>
      </view>
      
      <view class="user-info-section">
        <text class="user-name">{{userInfo.nickName || userInfo.username || userInfo.account || '未登录'}}</text>
        <text class="user-account" wx:if="{{userInfo.account}}">账号：{{userInfo.account}}</text>
        <text class="user-status">{{hasUserInfo ? '宠宿无忧用户' : '未登录用户'}}</text>
      </view>
      
      <!-- 操作按钮 -->
      <view class="action-buttons">
        <button wx:if="{{!hasUserInfo}}" class="action-btn primary" bindtap="goToLogin">
          <text class="btn-icon">🔐</text>
          <text class="btn-text">立即登录</text>
        </button>
        
        <button wx:if="{{hasUserInfo}}" class="action-btn secondary" bindtap="logout">
          <text class="btn-icon">🚪</text>
          <text class="btn-text">退出登录</text>
        </button>
      </view>
    </view>
    
    <!-- 功能菜单 -->
    <view class="menu-section">
      <view class="menu-group">
        <text class="group-title">我的服务</text>
        
        <view class="menu-item" bindtap="goToMyPets">
          <view class="menu-left">
            <text class="menu-icon">🐕</text>
            <text class="menu-text">我的宠物</text>
          </view>
          <text class="menu-arrow">></text>
        </view>
        
        <view class="menu-item" bindtap="goToFavorites">
          <view class="menu-left">
            <text class="menu-icon">🏨</text>
            <text class="menu-text">我的收藏</text>
          </view>
          <text class="menu-arrow">></text>
        </view>
        
        <view class="menu-item" bindtap="goToAIAssistant">
          <view class="menu-left">
            <text class="menu-icon">🤖</text>
            <text class="menu-text">AI助手</text>
          </view>
          <text class="menu-arrow">></text>
        </view>
      </view>

    </view>
  </view>
</view>