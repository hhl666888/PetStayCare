/* pages/order/create/create.wxss */
.create-order-container {
  padding: 0 0 120rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 进度条 */
.progress-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.progress-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.progress-item:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -50%;
  width: 100%;
  height: 2rpx;
  background: #e0e0e0;
  transform: translateY(-50%);
}

.progress-item.active .progress-text {
  color: #FF6B35;
  font-weight: bold;
}

.progress-text {
  font-size: 24rpx;
  color: #999;
}

/* 区块样式 */
.section {
  background: white;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 信息行样式 */
.info-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  min-width: 200rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  text-align: right;
}

.address-text {
  font-size: 26rpx;
  color: #666;
}

.price-text {
  color: #FF6B35;
  font-weight: bold;
  font-size: 32rpx;
}

.discount-text {
  color: #52c41a;
  font-weight: bold;
}

.total-row {
  border-top: 2rpx solid #FF6B35;
  padding-top: 20rpx;
  margin-top: 10rpx;
}

.total-label {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.total-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF6B35;
}

/* 选择器样式 */
.picker-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
  padding-right: 20rpx;
}

/* 表单输入 */
.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
  padding: 10rpx 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
}

/* 宠物信息 */
.pet-item {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.pet-info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #e0e0e0;
}

.pet-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.delete-btn {
  font-size: 24rpx;
  color: #FF6B35;
  padding: 5rpx 15rpx;
  background: #fff;
  border-radius: 4rpx;
}

.empty-tip {
  text-align: center;
  padding: 40rpx 0;
}

.tip-text {
  font-size: 28rpx;
  color: #999;
}

.add-pet-btn {
  width: 100%;
  height: 80rpx;
  background: #FF6B35;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
}

/* 服务条款 */
.terms-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.terms-checkbox {
  margin-right: 15rpx;
  margin-top: 5rpx;
}

.terms-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 底部栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom, 0));
  background: #fff;
  border-top: 1rpx solid #e0e0e0;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.total-display {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
}

.total-text {
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.total-amount {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B35;
  margin-left: 10rpx;
  flex-shrink: 0;
}

.submit-btn {
  min-width: 220rpx;
  height: 80rpx;
  padding: 0 30rpx;
  background: #FF6B35;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  flex-shrink: 0;
  margin-left: 20rpx;
  line-height: 80rpx;
}

.submit-btn text {
  display: inline-block;
  white-space: nowrap;
}

.submit-btn::after {
  border: none;
}

.submit-btn.disabled {
  background: #ccc;
  color: #fff;
}

/* 加载状态 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #FF6B35;
  border-radius: 50%;
  animation: rotate 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

/* 酒店信息 */
.hotel-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hotel-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.hotel-address, .hotel-phone {
  font-size: 26rpx;
  color: #666;
}

/* 日期选择 */
.date-row {
  display: flex;
  gap: 20rpx;
}

.date-item {
  flex: 1;
}

.date-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.date-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  background: white;
}

.picker-arrow {
  color: #999;
  font-size: 20rpx;
}

.nights-info {
  text-align: center;
  margin-top: 16rpx;
}

.nights-text {
  font-size: 28rpx;
  color: #ff9a76;
  font-weight: bold;
  background: rgba(255, 154, 118, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 154, 118, 0.2);
}

/* 预约时间 */
.appointment-row {
  display: flex;
  gap: 20rpx;
}

.appointment-item {
  flex: 1;
}

.appointment-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.appointment-info {
  text-align: center;
  margin-top: 16rpx;
  padding: 16rpx;
  background: rgba(102, 126, 234, 0.1);
  border-radius: 12rpx;
  border: 1rpx solid rgba(102, 126, 234, 0.2);
}

.appointment-summary {
  font-size: 26rpx;
  color: #667eea;
  font-weight: 500;
  display: block;
}

/* 宠物信息 */
.pet-actions {
  display: flex;
  gap: 12rpx;
}

.add-pet-btn {
  font-size: 24rpx;
  color: #ff9a76;
  padding: 8rpx 16rpx;
  border: 1rpx solid #ff9a76;
  border-radius: 20rpx;
}

.add-pet-btn.manual {
  color: #667eea;
  border-color: #667eea;
}

/* 空宠物提示 */
.empty-pet-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 30rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 2rpx dashed #ddd;
}

.tip-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.tip-subtext {
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

/* 只读样式 */
.form-input.readonly {
  background: #f5f5f5;
  color: #666;
}

.picker-readonly {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
}

.pet-card {
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.pet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.pet-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.remove-pet-btn {
  font-size: 24rpx;
  color: #dc3545;
  padding: 6rpx 12rpx;
  border: 1rpx solid #dc3545;
  border-radius: 12rpx;
}

.pet-form {
  /* 宠物表单样式 */
}

/* 宠物头像上传 */
.pet-avatar-section {
  margin-bottom: 30rpx;
  text-align: center;
}

/* 只读头像预览 */
.avatar-preview-only {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
  margin: 0 auto;
  border: 3rpx solid rgba(255, 154, 118, 0.3);
}

.avatar-upload {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
  margin: 0 auto;
  border: 3rpx solid rgba(255, 154, 118, 0.3);
  transition: all 0.3s ease;
}

.avatar-upload:active {
  transform: scale(0.95);
  border-color: #ff9a76;
}

.avatar-upload.uploading {
  border-color: #ff9a76;
  opacity: 0.8;
}

.avatar-preview {
  width: 100%;
  height: 100%;
  border-radius: 60rpx;
  background: #f5f5f5;
}

.upload-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 60rpx;
}

.upload-text {
  color: white;
  font-size: 20rpx;
  text-align: center;
}

/* 上传中状态 */
.uploading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 60rpx;
}

.uploading-spinner {
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-top: 2rpx solid #ff9a76;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 8rpx;
}

.uploading-text {
  color: white;
  font-size: 18rpx;
  text-align: center;
}

/* 表单样式 */
.form-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-item.half {
  flex: 1;
}

.form-label {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: white;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: white;
}

.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  background: white;
  width: 100%;
}



/* 价格明细 */
.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.price-label {
  font-size: 26rpx;
  color: #666;
}

.price-value {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.price-item.discount .price-value {
  color: #28a745;
}

.price-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #e0e0e0;
}

.total-label {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.total-value {
  font-size: 36rpx;
  color: #ff9a76;
  font-weight: bold;
}

/* 服务条款 */
.terms-container {
  padding: 30rpx;
  background: #fff3cd;
  border: 3rpx solid #ff6b6b;
  border-radius: 12rpx;
  margin-bottom: 200rpx;
  position: relative;
  text-align: center;
}

.terms-container::before {
  content: '⚠️ 必须勾选此协议才能预订';
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #ff6b6b;
  color: white;
  padding: 8rpx 20rpx;
  border-radius: 25rpx;
  font-size: 22rpx;
  font-weight: bold;
  white-space: nowrap;
  z-index: 10;
}

.terms-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.terms-checkbox {
  transform: scale(1.2);
}

.terms-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  font-weight: 500;
}

.terms-container {
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.4);
  }
  70% {
    box-shadow: 0 0 0 10rpx rgba(255, 193, 7, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(255, 193, 7, 0);
  }
}

/* 底部按钮 */
.bottom-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  padding-bottom: env(safe-area-inset-bottom, 20rpx);
  border-top: 1rpx solid #e0e0e0;
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.price-summary {
  flex: 1;
}

.summary-label {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 4rpx;
}

.summary-price {
  font-size: 32rpx;
  color: #ff9a76;
  font-weight: bold;
  display: block;
}

.submit-btn {
  background: linear-gradient(135deg, #ff9a76 0%, #ff7a45 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 60rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(255, 154, 118, 0.3);
}

.submit-btn.disabled {
  background: #ccc;
  color: #999;
}

/* 加载状态 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top: 4rpx solid #ff9a76;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

.loading-text {
  color: white;
  font-size: 28rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}