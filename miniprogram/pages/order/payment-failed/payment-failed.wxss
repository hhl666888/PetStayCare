/* pages/order/payment-failed/payment-failed.wxss */
.payment-failed-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f5f5 0%, #e8e8e8 100%);
  padding: 30rpx;
  padding-bottom: 120rpx;
}

/* 图标区域 */
.icon-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.icon-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff7e6 0%, #ffe4cc 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
}

.failed-icon {
  font-size: 80rpx;
}

.failed-title {
  font-size: 40rpx;
  color: #333;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.failed-desc {
  font-size: 28rpx;
  color: #666;
}

.countdown-timer {
  margin-top: 24rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #fff7e6 0%, #fff0d9 100%);
  border-radius: 40rpx;
  display: inline-block;
}

.timer-text {
  font-size: 28rpx;
  color: #fa8c16;
  font-weight: 600;
}

.expired-tip {
  margin-top: 24rpx;
}

.expired-text {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: 500;
}

/* 订单信息 */
.order-info-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.hotel-info {
  margin-bottom: 24rpx;
}

.hotel-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}

.hotel-address {
  font-size: 26rpx;
  color: #999;
}

.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 24rpx 0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.info-row:not(:last-child) {
  border-bottom: 1rpx solid #f5f5f5;
}

.info-label {
  font-size: 28rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

.copy-btn {
  color: #1890ff;
}

/* 失败原因 */
.reason-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.reason-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.reason-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.reason-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.reason-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 操作按钮 */
.action-section {
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.retry-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 12rpx 24rpx rgba(7, 193, 96, 0.25);
}

.retry-btn.expired {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a5a 100%);
  box-shadow: 0 12rpx 24rpx rgba(255, 107, 107, 0.25);
}

.retry-btn::after {
  border: none;
}

.btn-icon {
  font-size: 36rpx;
}

.btn-text {
  font-size: 32rpx;
}

.view-order-btn {
  width: 100%;
  height: 96rpx;
  background: #fff;
  color: #666;
  border: 2rpx solid #d9d9d9;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.view-order-btn::after {
  border: none;
}

/* 提示信息 */
.tip-section {
  background: #f0f5ff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  border-left: 6rpx solid #1890ff;
}

.tip-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.tip-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #595959;
  line-height: 1.6;
}
